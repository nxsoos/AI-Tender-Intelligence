# Browser-safe Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Server-only privileged Supabase key. Never prefix this with NEXT_PUBLIC_.
# A legacy SUPABASE_SERVICE_ROLE_KEY is accepted as an alternative.
SUPABASE_SECRET_KEY=YOUR_SECRET_KEY

# Server-only Google AI Studio API key
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.8-flash
